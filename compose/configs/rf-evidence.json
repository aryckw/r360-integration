{
  "service_name": "r360-rf-evidence",
  "sensor_id": "sensor-alpha",
  "session_id": "sess-integration",
  "mqtt": {
    "broker_uri": "tcp://mqtt:1883",
    "client_id": "r360-rf-evidence-integration",
    "keep_alive_seconds": 20,
    "connect_timeout_seconds": 5,
    "clean_session": true
  },
  "grpc": {
    "listen_address": "0.0.0.0:50051"
  },
  "source": {
    "kind": "sigmf",
    "capture_uri": "",
    "corpus_root": "/work/build/corpus",
    "block_size_samples": 65536
  },
  "buffer_pool": {
    "buffer_count": 8,
    "samples_per_buffer": 65536
  },
  "queues": [
    {
      "name": "ingest",
      "capacity_buffers": 4,
      "overflow_policy": "BLOCK"
    },
    {
      "name": "evidence",
      "capacity_buffers": 256,
      "overflow_policy": "BLOCK"
    }
  ],
  "evidence_type_allowlist": [
    "SIGNAL_DETECTION",
    "PULSE_DETECTION",
    "RF_FEATURE_SET"
  ],
  "dataplane": {
    "stages": [
      "block_power",
      "spectral_detector",
      "pulse_detector",
      "pulse_grouping"
    ],
    "backend_preference": [
      "cuda",
      "cpu_simd",
      "cpu_scalar"
    ],
    "fuse_stages": false
  },
  "detection": {
    "spectral": {
      "fft_size": 1024,
      "window": "hann",
      "threshold_db": 10.0,
      "min_bins": 1,
      "max_signals_per_block": 32
    },
    "pulse": {
      "method": "ca_cfar",
      "threshold_db": 10.0,
      "guard_cells": 48,
      "training_cells": 64,
      "target_pfa": 1e-06,
      "edge_policy": "skip",
      "extent_db": 6.0,
      "min_pulse_samples": 3,
      "max_gap_samples": 2,
      "max_pulse_samples": 4096,
      "integration_samples": 4
    },
    "grouping": {
      "frequency_tolerance_hz": 5000.0,
      "train_gap_s": 0.5,
      "max_open_trains": 16,
      "min_pulses_for_train": 3
    },
    "max_detections_per_block": 4096
  }
}
